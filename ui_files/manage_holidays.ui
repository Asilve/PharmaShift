   <property name="styleSheet">
    <string notr="true">QFrame#filter_frame {
    background-color: #FFFFFF;
    border: 1px solid #D7DEE5;
    border-radius: 8px;
}
QLabel#employee_label,
QLabel#from_label,
QLabel#to_label {
    color: #52636F;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}
QComboBox#employee_combo {
    background-color: #FFFFFF;
    color: #263238;
    border: 1px solid #BFC9D1;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
}

QComboBox#employee_combo:hover {
    border: 1px solid #9AAAB5;
}

QComboBox#employee_combo:focus {
    border: 1px solid #71808A;
}

QComboBox#employee_combo QAbstractItemView {
    background-color: #FFFFFF;
    color: #263238;
    border: 1px solid #BFC9D1;
    selection-background-color: #E9EEF2;
    selection-color: #263238;
}
QDateEdit#from_date_edit,
QDateEdit#to_date_edit {
    background-color: #FFFFFF;
    color: #263238;
    border: 1px solid #BFC9D1;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 28px;
}

QDateEdit#from_date_edit:hover,
QDateEdit#to_date_edit:hover {
    border: 1px solid #9AAAB5;
}

QDateEdit#from_date_edit:focus,
QDateEdit#to_date_edit:focus {
    border: 1px solid #71808A;
}
QDateEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
}

QDateEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
}

QPushButton#clear_button {
    background-color: #F4F7FA;
    color: #52636F;
    border: 1px solid #D7DEE5;
    border-radius: 6px;
    padding: 5px 12px;
    min-height: 28px;
}

QPushButton#clear_button:hover {
    background-color: #E9EEF2;
}

QPushButton#clear_button:pressed {
    background-color: #DDE4E9;
}</string>
